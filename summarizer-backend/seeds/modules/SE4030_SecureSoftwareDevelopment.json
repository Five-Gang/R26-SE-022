      "lo_coverage": ["LO5"]
    },
    {
      "week_number": 13,
      "topic": "Security Governance and Responsible Vulnerability Disclosure",
      "subtopics": [
        "Enterprise security management practices",
        "Activities of a Security Operations Center (SOC)",
        "Responsible vulnerability disclosure process",
        "Bug bounty programs and CVE reporting"
      ],
      "lo_coverage": ["LO5"]
    }
  ]
