# =============================================================================
# AuraLearn — Secrets File Template
# Copy this file to secrets.env, fill in real values, then run deploy.sh
# NEVER commit secrets.env to git!
# =============================================================================

# App
SECRET_KEY=your-secret-key-here

# PostgreSQL
POSTGRES_PASSWORD=change-me-in-production

# MinIO
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Google / Gemini
GOOGLE_API_KEY=your-google-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here

# OpenAI
OPENAI_API_KEY=sk-your-openai-key-here

# MongoDB (adaptive-reminder-system)
MONGODB_URL=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/reminder_db

# JWT
JWT_SECRET=your-jwt-secret-here
